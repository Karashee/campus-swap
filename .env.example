# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-me-with-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated. Leave empty to allow sign-ups from any email domain.
ALLOWED_SIGNUP_EMAIL_DOMAINS=strathmore.edu

# Login throttle (see SECURITY.md). Failed attempts allowed per username and
# per IP address, and how long the count and the resulting lockout last.
LOGIN_RATELIMIT_ATTEMPTS=5
LOGIN_RATELIMIT_WINDOW=900
